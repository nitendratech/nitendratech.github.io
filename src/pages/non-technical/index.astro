---
import BaseLayout from '../../layouts/BaseLayout.astro';

// This section moved into the blog category archives (Nov 7, 2026 redesign).
// The old URL keeps working: it redirects to the category page.
const target = '/blog/category/non-technical/';
---
<BaseLayout
  title="Non-Technical | NitendraTech"
  description="Non-technical posts by Nitendra Gautam — life, observations, and everything outside technology."
>
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <link rel="canonical" href="https://nitendratech.github.io/blog/category/non-technical/" slot="head" />
  <main>
    <h1>Non-Technical</h1>
    <p>This section has moved into the blog's category pages. <a href={target}>Continue to Non-Technical articles →</a></p>
    <script define:vars={{ target }}>window.location.replace(target);</script>
  </main>
</BaseLayout>
