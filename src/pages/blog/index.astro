---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/site.js';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Blog | NitendraTech"
  description="Articles on data engineering, AI/ML platforms, cloud architecture and engineering leadership."
>
  <main>
    <h1>Blog</h1>
    <p>Polished, reader-focused articles. Each one ends with a takeaway you can use. Broader technology topics live under <a href="/general-technology/">General Technology</a>, and non-technical posts under <a href="/non-technical/">Non-Technical</a>.</p>
    <p><a class="btn secondary" href="/search/">🔍 Search all articles</a></p>

    <h2>Categories</h2>
    <ul>
      {categories.map((c) => (
        <li><strong>{c.name}</strong> — {c.sub}</li>
      ))}
    </ul>

    <h2>Latest posts</h2>
    {posts.map((post) => <PostCard post={post} />)}

    <p class="small">More WordPress articles will appear here in batches by category, once the inventory and import (Phase 4 of the migration plan) is complete. The tracker in content/tracker.md records every article, so no topic is repeated or lost.</p>
  </main>
</BaseLayout>
