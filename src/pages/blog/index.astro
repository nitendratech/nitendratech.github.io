---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pager from '../../components/Pager.astro';
import { categories } from '../../data/site.js';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pageSize = 10;
const lastPage = Math.max(1, Math.ceil(allPosts.length / pageSize));
const posts = allPosts.slice(0, pageSize);
const countFor = (name) => allPosts.filter((p) => p.data.category === name).length;
---
<BaseLayout
  title="Blog | NitendraTech"
  description="Articles on data engineering, AI/ML platforms, cloud architecture and engineering leadership."
>
  <main>
    <h1>Blog</h1>
    <p>Polished, reader-focused articles. Each one ends with a takeaway you can use. Pick a category to see only its articles, or browse the latest posts below.</p>
    <p><a class="btn secondary" href="/search/">🔍 Search all articles</a></p>

    <h2>Browse by category</h2>
    <div class="catcards">
      {categories.map((c) => (
        <a class="card catcard" href={`/blog/category/${c.slug}/`}>
          <strong>{c.name}</strong>
          <span class="small">{c.sub}</span>
          <span class="tag">{countFor(c.name)} articles</span>
        </a>
      ))}
    </div>

    <h2>Latest posts</h2>
    {posts.map((post) => <PostCard post={post} />)}

    <Pager currentPage={1} lastPage={lastPage} />

    <p class="small">Showing 10 of {allPosts.length} articles per page. Every article from the old WordPress site is now published here; the tracker records every article, so no topic is repeated or lost.</p>
  </main>
</BaseLayout>
