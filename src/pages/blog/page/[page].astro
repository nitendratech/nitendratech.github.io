---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pager from '../../../components/Pager.astro';

export async function getStaticPaths() {
  const pageSize = 10;
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const lastPage = Math.ceil(posts.length / pageSize);
  const paths = [];
  for (let n = 2; n <= lastPage; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        posts: posts.slice((n - 1) * pageSize, n * pageSize),
        currentPage: n,
        lastPage,
        total: posts.length,
      },
    });
  }
  return paths;
}

const { posts, currentPage, lastPage, total } = Astro.props;
---
<BaseLayout
  title={`Blog – Page ${currentPage} | NitendraTech`}
  description="Articles on data engineering, AI/ML platforms, cloud architecture and engineering leadership."
>
  <main>
    <h1>Blog</h1>
    <p class="small">Page {currentPage} of {lastPage} · {total} articles · <a href="/blog/">Newest posts</a> · <a href="/search/">Search all articles</a></p>

    {posts.map((post) => <PostCard post={post} />)}

    <Pager currentPage={currentPage} lastPage={lastPage} />
  </main>
</BaseLayout>
