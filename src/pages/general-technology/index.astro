---
import BaseLayout from '../../layouts/BaseLayout.astro';

// This section moved into the blog category archives (Nov 7, 2026 redesign).
// The old URL keeps working: it redirects to the category page.
const target = '/blog/category/general-technology/';
---
<BaseLayout
  title="General Technology | NitendraTech"
  description="General technology topics by Nitendra Gautam that do not fit the other categories."
>
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <link rel="canonical" href="https://nitendratech.github.io/blog/category/general-technology/" slot="head" />
  <main>
    <h1>General Technology</h1>
    <p>This section has moved into the blog's category pages. <a href={target}>Continue to General Technology articles →</a></p>
    <script define:vars={{ target }}>window.location.replace(target);</script>
  </main>
</BaseLayout>
